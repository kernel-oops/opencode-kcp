{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "opencode-kcp",
    "version": "3.2.0-kernel-oops.20261023.1",
    "private": true,
    "type": "module",
    "workspaces": [
        "tests/logger"
    ],
    "description": "OpenCode plugin that optimizes token usage by pruning obsolete tool outputs from conversation context",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tui": {
            "types": "./dist/tui.d.ts",
            "import": "./tui.tsx"
        }
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "npm run clean && tsup && tsc --emitDeclarationOnly",
        "verify:package": "node scripts/verify-package.mjs",
        "check:package": "npm run build && npm run verify:package",
        "prepublishOnly": "npm run check:package",
        "dev": "opencode plugin dev",
        "sandbox": "node scripts/sandbox.mjs",
        "typecheck": "tsc --noEmit && npm run typecheck --workspace=tests/logger",
        "test": "node -e \"require('node:fs').mkdirSync('.impl-private', { recursive: true })\" && node --import tsx --import ./tests/fixtures/jsonc-node-loader.mjs --test --test-concurrency=2 tests/*.test.ts && npm test --workspace=tests/logger",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "dcp": "tsx scripts/print.ts"
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "plugin",
        "context",
        "pruning",
        "optimization",
        "tokens"
    ],
    "author": "tarquinen",
    "license": "AGPL-3.0-or-later",
    "peerDependencies": {
        "@opencode-ai/plugin": ">=1.18.29"
    },
    "peerDependenciesMeta": {
        "@opencode-ai/plugin": {
            "optional": true
        }
    },
    "dependencies": {
        "@anthropic-ai/tokenizer": "^0.0.4",
        "jsonc-parser": "^3.3.1",
        "zod": "4.6.6"
    },
    "devDependencies": {
        "@opencode-ai/plugin": "^1.18.29",
        "@opencode-ai/sdk": "^1.4.3",
        "@opentui/core": "0.5.10",
        "@opentui/solid": "0.5.10",
        "solid-js": "1.9.12",
        "@opencode/plugin": "^2.0.4",
        "@opencode/theme": "^2.0.4",
        "@types/node": "^25.5.0",
        "prettier": "^3.8.1",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "5.9.3"
    },
    "overrides": {
        "zod@4.1.8": "$zod",
        "solid-js@1.9.12": {
            "seroval": "1.6.12",
            "seroval-plugins": "1.6.12"
        },
        "undici@^8.10.0": "8.12.2",
        "undici@^6.25.0": "6.29.1",
        "http-cache-semantics@^4.1.1": "4.3.0",
        "toml@^4.1.1": "5.0.1",
        "brace-expansion@^2.0.0": "2.1.7",
        "@babel/core": "7.29.7",
        "esbuild": "0.28.1"
    },
    "files": [
        "dist/",
        "lib/",
        "server.js",
        "tui.tsx",
        "dcp.schema.json",
        "README.md",
        "LICENSE"
    ]
}
